Z_ARCHIVED/
RAW_DATA/
CLEAN_DATA/
VERITY_DATASET/

# Ignore specified subdirectories inside 'data/'
data/RAW_DATA/
data/CLEAN_DATA/
data/VERITY_DATASET/

# Database files are mounted at runtime, never baked into the image
**/*.sqlite3
**/*.sqlite3.*
**/*.sqlite3-*
**/*.db
**/*.backup

# Secrets are injected at runtime (docker run -e / --env-file)
.env
**/.env
**/.env.*

# Ignore Python virtual environment and cache
venv/
.venv/
**/__pycache__/
**/*.pyc
.pytest_cache/

# Ignore Git and other development artifacts
.git/
.gitignore
.dockerignore
README.md
docs/

# Logs and local data files
logs/
**/*.log
**/*.tar
**/*.tar.gz
**/*.tgz
**/samples.txt
**/*.xlsx
